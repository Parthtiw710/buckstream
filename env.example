# Comma-separated list of allowed domains for CORS checks
ALLOWED_DOMAINS=localhost:3000,app.example.com

# --- IAM Authentication (Keyless Cloud Hosting) ---
# Set S3_BY_IAM=true if running on AWS (ECS, EC2, Lambda) using IAM Task/Instance Roles
S3_BY_IAM=false

# Set GCS_BY_IAM=true if running on GCP (Cloud Run, GKE) using Application Default Credentials / Service Accounts
GCS_BY_IAM=false

# --- S3-Compatible Token Authentication (Static Keys) ---
# Set S3_COMPATIBLE_BY_TOKEN=true to use static API credentials.
# This works for AWS S3, Cloudflare R2, Backblaze B2, Wasabi, or GCS (in S3 interoperability mode).
S3_COMPATIBLE_BY_TOKEN=false
S3_COMPATIBLE_ENDPOINT=
S3_COMPATIBLE_REGION=us-east-1
S3_COMPATIBLE_ACCESS_KEY=
S3_COMPATIBLE_ACCESS_SECRET=

# --- Storage Settings ---
# The default bucket name used for storing site assets and media
BUCKET_NAME=

# --- Security Settings ---
# Token for deploying static sites (GitHub Actions, CLI, developers)
DEPLOY_TOKEN=

# Token for normal client-side runtime uploads (media, avatars)
UPLOAD_TOKEN=
